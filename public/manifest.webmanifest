{
  "name": "intip",
  "short_name": "intip",
  "description": "Private notes, images, and files.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f6f4ef",
  "theme_color": "#11685c",
  "orientation": "portrait",
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "sharedFiles",
          "accept": [
            "image/*",
            "application/pdf",
            ".pdf",
            "text/*",
            ".txt",
            ".csv",
            "application/zip",
            ".zip",
            ".docx",
            ".xlsx",
            ".pptx",
            ".hwp"
          ]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "/icons/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
